// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// Audit
// ======================================================

enum AuditActorType {
  USER
  ADMIN
  SYSTEM
}

enum AuditAction {
  // Auth
  LOGIN
  LOGOUT
  REGISTER

  ACCOUNT_LOCKED
  ACCOUNT_UNLOCKED

  PASSWORD_CHANGED
  PASSWORD_RESET_REQUESTED
  PASSWORD_RESET_COMPLETED

  REFRESH_TOKEN_REUSE_DETECTED
  PERMISSION_DENIED

  // User moderation
  USER_BANNED
  USER_UNBANNED
  USER_ROLE_CHANGED

  // Challenge CMS
  CHALLENGE_CREATED
  CHALLENGE_UPDATED
  CHALLENGE_DELETED
  CHALLENGE_PUBLISHED
  CHALLENGE_UNPUBLISHED

  CHALLENGE_FLAG_CHANGED

  ATTACHMENT_UPLOADED
  ATTACHMENT_DELETED

  // chapter CMS
  CHAPTER_CREATED
  CHAPTER_UPDATED
  CHAPTER_DELETED
  CHAPTER_PUBLISHED
  CHAPTER_UNPUBLISHED

  // Scene CMS
  SCENE_CREATED
  SCENE_UPDATED
  SCENE_DELETED
  SCENE_PUBLISHED
  SCENE_UNPUBLISHED

  // Evidence CMS
  EVIDENCE_CREATED
  EVIDENCE_UPDATED
  EVIDENCE_DELETED
  EVIDENCE_PUBLISHED
  EVIDENCE_UNPUBLISHED

  // Unlock Rule CMS
  UNLOCK_RULE_CREATED
  UNLOCK_RULE_UPDATED
  UNLOCK_RULE_DELETED

  // Story
  STORY_RESTARTED

  // Leaderboard
  LEADERBOARD_FROZEN
  LEADERBOARD_UNFROZEN
  LEADERBOARD_RECALCULATED

  SCORE_ADJUSTED

  // Event
  EVENT_UPDATED

  // Export
  EXPORT_LEADERBOARD
  EXPORT_SUBMISSIONS
  EXPORT_AUDIT

  // Admin / Event Operations
  EVENT_PAUSED
  EVENT_RESUMED
  REGISTRATION_ENABLED
  REGISTRATION_DISABLED

  // Security Operations
  SECURITY_SIGNAL_STATUS_CHANGED
  SECURITY_ALERT_CREATED
  SECURITY_ALERT_ACKNOWLEDGED
  SECURITY_ALERT_RESOLVED
  SECURITY_ALERT_DISMISSED

  // Incident Management
  INCIDENT_CREATED
  INCIDENT_ACKNOWLEDGED
  INCIDENT_STATUS_CHANGED
  INCIDENT_RESOLVED
  INCIDENT_CLOSED

  // Emergency Operations
  EMERGENCY_OPERATION

  // Announcements
  ANNOUNCEMENT_CREATED
  ANNOUNCEMENT_UPDATED
  ANNOUNCEMENT_ARCHIVED
}

enum AuditResourceType {
  USER
  EVENT
  CHALLENGE
  SUBMISSION
  CHAPTER
  SCENE
  LEADERBOARD
  SYSTEM
  EVIDENCE
  UNLOCK_RULE
  ANNOUNCEMENT
  EVENT_CONTROL
  SECURITY_SIGNAL
  SECURITY_ALERT
  INCIDENT
}

model AuditLog {
  id String @id @default(cuid())

  occurredAt DateTime @default(now())

  // Who performed it
  actorType     AuditActorType
  actorId       String?
  actorUsername String?        @db.VarChar(30)
  actorRole     Role?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  // Action
  action  AuditAction
  success Boolean
  reason  String?     @db.VarChar(255)

  // Resource — untyped reference, same trade-off as UnlockRule.referenceId.
  resourceType AuditResourceType
  resourceId   String?
  resourceName String?           @db.VarChar(200)

  // Context — requestId/sessionId provisioned, currently always null
  // until request-id propagation exists; cheap to have now, no schema
  // churn later.
  ipAddress String? @db.VarChar(45)
  userAgent String? @db.VarChar(255)
  requestId String? @db.VarChar(100)
  sessionId String? @db.VarChar(100)

  // Structured payload — MUST be passed through redact() (lib/logger/redact.ts)
  // before being written; see the note above this schema.
  before   Json?
  after    Json?
  metadata Json?

  securitySignals SecuritySignal[]

  @@index([occurredAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@index([resourceType])
  @@index([resourceId])
  @@map("audit_logs")
}

// ======================================================
// Rate Limiting
// ======================================================

model RateLimitBucket {
  key       String   @id @db.VarChar(300)
  count     Int      @default(1)
  expiresAt DateTime @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

// ======================================================
// User Module
// ======================================================

enum Role {
  USER
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BANNED
}

model User {
  id String @id @default(cuid())

  // Identity
  fullName String @db.VarChar(100)
  username String @unique @db.VarChar(30)
  email    String @unique @db.VarChar(255)

  // Authentication
  passwordHash      String    @db.VarChar(255)
  emailVerified     Boolean   @default(false)
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?

  // Refresh Tokens
  refreshTokens RefreshToken[]

  // Authorization
  role Role @default(USER)

  // Account Status
  status UserStatus @default(ACTIVE)

  // Brute-force protection
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  submissions     Submission[]
  challengeSolves ChallengeSolve[]

  // Story
  storyProgress    StoryProgress?
  sceneCompletions SceneCompletion[]
  choiceSelections ChoiceSelection[]

  // Audit
  lastLoginAt        DateTime?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  leaderboardEntries LeaderboardEntry?
  auditLogs          AuditLog[]
  playerHints        PlayerHint[]
  announcements      Announcement[]
  notifications      Notification[]

  // Admin / Operations relations
  securitySignals            SecuritySignal[]
  securityAlertsAsSubject    SecurityAlert[]         @relation("SecurityAlertSubject")
  securityAlertsAcknowledged SecurityAlert[]         @relation("SecurityAlertAcknowledgedBy")
  securityAlertsResolved     SecurityAlert[]         @relation("SecurityAlertResolvedBy")
  incidentsCreated           Incident[]              @relation("IncidentCreatedBy")
  incidentsAssigned          Incident[]              @relation("IncidentAssignedTo")
  incidentsAcknowledged      Incident[]              @relation("IncidentAcknowledgedBy")
  incidentsResolved          Incident[]              @relation("IncidentResolvedBy")
  incidentsRelated           Incident[]              @relation("IncidentRelatedUser")
  incidentTimelineEntries    IncidentTimelineEntry[]
  eventControlsPaused        EventControl[]          @relation("EventControlPausedBy")

  @@map("users")
}

// ======================================================
// Refresh Token Module
// ======================================================

model RefreshToken {
  id     String @id @default(cuid())
  userId String

  tokenHash String @unique @db.VarChar(255)

  replacedByTokenId String? @unique

  expiresAt DateTime
  revokedAt DateTime?

  userAgent String? @db.VarChar(255)
  ipAddress String? @db.VarChar(45)

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ======================================================
// Event Module
// ======================================================

model Event {
  id String @id @default(cuid())

  singleton Int @unique @default(1)

  title       String  @db.VarChar(100)
  description String? @db.Text

  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)

  leaderboardFrozenAt DateTime? @db.Timestamptz(3)

  // Admin / Operations — current operational override state.
  control EventControl?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("events")
}

// ======================================================
// Shared content lifecycle — Chapter, Scene, Evidence all use this
// ======================================================

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ======================================================
// Chapter Module
// Formalizes what used to be Challenge.chapter (a bare Int) into a
// real entity both Challenge and Story attach to. See the backfill
// script below — this is NOT a drop-in replacement without a data
// migration, since existing challenges already reference chapter
// numbers 1-6.
// ======================================================

model Chapter {
  id    String @id @default(cuid())
  slug  String @unique @db.VarChar(160)
  title String @db.VarChar(150)
  order Int    @unique

  status ContentStatus @default(DRAFT)

  scenes     Scene[]
  challenges Challenge[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  storyProgresses StoryProgress[]

  @@map("chapters")
}

// ======================================================
// Challenge Module
// ======================================================

enum ChallengeAttachmentType {
  IMAGE
  PDF
  AUDIO
  VIDEO
  ARCHIVE
  OTHER
}

model Challenge {
  id String @id @default(cuid())

  // Identity
  title String @db.VarChar(150)
  slug  String @unique @db.VarChar(160)

  // Organization — chapterId replaces the old bare `chapter Int`
  chapterId    String
  displayOrder Int

  // Gameplay
  difficulty Int @default(1)

  xpReward Int @default(100)

  flagHash        String                @db.VarChar(255)
  attachments     ChallengeAttachment[]
  submissions     Submission[]
  challengeSolves ChallengeSolve[]

  prerequisites ChallengePrerequisite[] @relation("ChallengePrerequisites")
  requiredBy    ChallengePrerequisite[] @relation("RequiredByChallenges")

  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  scenes  Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  hints     Hint[]

  @@unique([chapterId, displayOrder])
  @@map("challenges")
}

model ChallengeAttachment {
  id String @id @default(cuid())

  challengeId String

  type ChallengeAttachmentType

  fileName String @db.VarChar(255)

  mimeType String? @db.VarChar(100)

  filePath String @db.VarChar(500)

  fileSize Int?

  order Int @default(0)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([challengeId])
  @@map("challenge_attachments")
}

model ChallengePrerequisite {
  challengeId String

  prerequisiteId String

  challenge Challenge @relation("ChallengePrerequisites", fields: [challengeId], references: [id], onDelete: Cascade)

  prerequisite Challenge @relation("RequiredByChallenges", fields: [prerequisiteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([challengeId, prerequisiteId])
  @@index([prerequisiteId])
  @@index([challengeId])
  @@map("challenge_prerequisites")
}

// ======================================================
// Submission Module
// ======================================================

model Submission {
  id String @id @default(cuid())

  userId      String
  challengeId String

  submittedFlag     String? @db.VarChar(255)
  submittedFlagHash String? @db.VarChar(255)

  isCorrect Boolean

  submittedAt DateTime @default(now())

  user           User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  challenge      Challenge       @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  challengeSolve ChallengeSolve?

  @@index([userId, challengeId, isCorrect])
  @@index([challengeId])
  @@index([userId, submittedAt])
  @@map("submissions")
}

model ChallengeSolve {
  userId      String
  challengeId String

  submissionId String @unique

  xpAwarded Int
  solvedAt  DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  challenge  Challenge  @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@id([userId, challengeId])
  @@index([challengeId])
  @@map("challenge_solves")
}

// ======================================================
// Leaderboard Module
// ======================================================

model LeaderboardEntry {
  userId  String @id
  totalXp Int    @default(0)

  solvedChallenges Int @default(0)

  lastSolvedAt DateTime?

  // NOTE: still plain Ints, not FKs — these track Chapter.order /
  // Challenge.displayOrder for sort/tiebreak purposes, not a
  // relationship. Once the backfill below runs, the write path
  // (leaderboardRepository.upsertForSolve) needs to pass
  // `challenge.chapter.order` here instead of the old raw `chapter`
  // number — same field, same meaning, different source.
  highestChapter Int @default(0)

  highestDisplayOrder Int @default(0)

  updatedAt DateTime @updatedAt

  user    User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version Int  @default(0)

  @@index([totalXp(sort: Desc), solvedChallenges(sort: Desc), lastSolvedAt(sort: Asc)])
  @@map("leaderboard_entries")
}

// ======================================================
// Story Module
// ======================================================

enum SceneType {
  DIALOGUE
  CUTSCENE
  EVIDENCE_REVEAL
  CHALLENGE_GATE
  CHOICE
}

model Scene {
  id        String  @id @default(cuid())
  chapterId String
  slug      String  @db.VarChar(160)
  title     String? @db.VarChar(150)

  type  SceneType
  order Int

  status ContentStatus @default(DRAFT)

  // Only set when type = CHALLENGE_GATE.
  challengeId String?
  // Only set when type = EVIDENCE_REVEAL.
  evidenceId  String?

  // Cinematic/config data (cutscene asset key, background track,
  // camera notes) — JSON rather than dedicated columns so new scene
  // types and cinematic features never require a migration.
  metadata Json?

  chapter   Chapter    @relation(fields: [chapterId], references: [id], onDelete: Restrict)
  challenge Challenge? @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  evidence  Evidence?  @relation(fields: [evidenceId], references: [id], onDelete: Restrict)

  dialogueLines    DialogueLine[]
  choices          Choice[]          @relation("SceneChoices")
  incomingChoices  Choice[]          @relation("ChoiceDestination")
  sceneCompletions SceneCompletion[]
  choiceSelections ChoiceSelection[]
  storyProgress    StoryProgress[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([chapterId, slug])
  @@unique([chapterId, order])
  @@index([challengeId])
  @@index([evidenceId])
  @@map("scenes")
}

model Character {
  id          String  @id @default(cuid())
  slug        String  @unique @db.VarChar(60)
  displayName String  @db.VarChar(100)
  portraitUrl String? @db.VarChar(500)

  // Voice config / personality tags for a future Advisor system —
  // kept flexible rather than adding columns speculatively.
  metadata Json?

  dialogueLines DialogueLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("characters")
}

model DialogueLine {
  id          String  @id @default(cuid())
  sceneId     String
  characterId String?

  order    Int
  content  String  @db.Text
  audioUrl String? @db.VarChar(500) // future voice acting — provisioned, unused today

  scene     Scene      @relation(fields: [sceneId], references: [id], onDelete: Cascade)
  character Character? @relation(fields: [characterId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sceneId, order])
  @@index([characterId])
  @@map("dialogue_lines")
}

model Choice {
  id      String @id @default(cuid())
  sceneId String

  order Int
  label String @db.VarChar(200)

  // Nullable only to allow authoring a choice before its destination
  // exists yet — the service layer enforces that a PUBLISHED scene
  // never has a choice with a null nextSceneId, not the schema.
  nextSceneId String?

  scene     Scene  @relation("SceneChoices", fields: [sceneId], references: [id], onDelete: Cascade)
  nextScene Scene? @relation("ChoiceDestination", fields: [nextSceneId], references: [id], onDelete: Restrict)

  choiceSelections ChoiceSelection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sceneId, order])
  @@index([nextSceneId])
  @@map("choices")
}

enum EvidenceType {
  CHAT_LOG
  WALLET_LEDGER
  GPS_PIN
  PHOTOGRAPH
  SURVEILLANCE_FOOTAGE
  FINGERPRINT
  DOCUMENT
  OTHER
}

model Evidence {
  id    String @id @default(cuid())
  slug  String @unique @db.VarChar(160)
  title String @db.VarChar(150)

  type    EvidenceType
  content String       @db.Text

  attachmentUrl String? @db.VarChar(500)

  status ContentStatus @default(DRAFT)

  scenes Scene[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("evidence")
}

enum UnlockTargetType {
  CHAPTER
  SCENE
  EVIDENCE
}

enum UnlockConditionType {
  CHALLENGE_SOLVED
  CHAPTER_COMPLETED
  SCENE_COMPLETED
  CHOICE_SELECTED
  EVENT_LIVE
}

model UnlockRule {
  id String @id @default(cuid())

  targetType UnlockTargetType
  targetId   String

  conditionType UnlockConditionType
  // Not a typed FK — can point at a Challenge, Chapter, Scene, or
  // Choice depending on conditionType. Referential integrity for this
  // field is enforced at the service layer (validated before saving),
  // not the database — see the Story domain design doc for the
  // reasoning behind this one deliberate exception.
  referenceId   String?

  createdAt DateTime @default(now())

  @@index([targetType, targetId, createdAt])
  @@map("unlock_rules")
}

enum StoryProgressStatus {
  IN_PROGRESS
  COMPLETED
}

model StoryProgress {
  userId String @id

  currentChapterId String?
  currentSceneId   String?

  status StoryProgressStatus @default(IN_PROGRESS)

  startedAt      DateTime  @default(now())
  lastActivityAt DateTime  @updatedAt
  completedAt    DateTime?

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentChapter Chapter? @relation(fields: [currentChapterId], references: [id], onDelete: SetNull)
  currentScene   Scene?   @relation(fields: [currentSceneId], references: [id], onDelete: SetNull)

  @@map("story_progress")
}

model SceneCompletion {
  userId  String
  sceneId String

  completedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene Scene @relation(fields: [sceneId], references: [id], onDelete: Restrict)

  @@id([userId, sceneId])
  @@index([sceneId])
  @@map("scene_completions")
}

model ChoiceSelection {
  userId   String
  sceneId  String
  choiceId String

  selectedAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  scene  Scene  @relation(fields: [sceneId], references: [id], onDelete: Restrict)
  choice Choice @relation(fields: [choiceId], references: [id], onDelete: Restrict)

  @@id([userId, sceneId])
  @@index([choiceId])
  @@map("choice_selections")
}

// ======================================================
// Hint Module
// ======================================================

enum HintLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
}

model Hint {
  id String @id @default(cuid())

  challengeId String

  title   String @db.VarChar(100)
  content String @db.Text

  level HintLevel

  xpCost Int @default(0)

  status ContentStatus @default(DRAFT)

  challenge Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  playerHints PlayerHint[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([challengeId, level])
  @@index([challengeId, level])
  @@map("hints")
}

model PlayerHint {
  userId String
  hintId String

  unlockedAt DateTime @default(now())

  xpSpent Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  hint Hint @relation(fields: [hintId], references: [id], onDelete: Cascade)

  @@id([userId, hintId])
  @@index([hintId])
  @@map("player_hints")
}

// ======================================================
// Annoucement Module
// ======================================================

enum AnnouncementPriority {
  NORMAL
  IMPORTANT
  CRITICAL
}

model Announcement {
  id String @id @default(cuid())

  title   String @db.VarChar(150)
  message String @db.Text

  priority AnnouncementPriority @default(NORMAL)

  status ContentStatus @default(PUBLISHED)

  createdById String

  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([createdById])
  @@map("announcements")
}

// ======================================================
// Notification Module
// ======================================================

enum NotificationType {
  ANNOUNCEMENT
  EVENT
  SECURITY
  SYSTEM
}

enum NotificationResourceType {
  ANNOUNCEMENT
  EVENT
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type     NotificationType
  priority NotificationPriority @default(NORMAL)

  title   String @db.VarChar(150)
  message String @db.Text

  resourceType NotificationResourceType?
  resourceId   String?

  readAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

// ======================================================
// Admin / Operations Module
// ======================================================

enum EventOperationalMode {
  NORMAL
  PAUSED
}

model EventControl {
  id String @id @default(cuid())

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  mode EventOperationalMode @default(NORMAL)

  // Orthogonal operational controls. Precedence is enforced by the service layer.
  registrationEnabled Boolean @default(true)

  // Current pause state only. Historical changes belong in AuditLog.
  pausedAt    DateTime? @db.Timestamptz(3)
  pauseReason String?   @db.VarChar(255)

  pausedById String?
  pausedBy   User?   @relation("EventControlPausedBy", fields: [pausedById], references: [id], onDelete: SetNull)

  updatedAt DateTime @updatedAt

  @@map("event_controls")
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SecuritySignalType {
  AUTH_FAILURE_SPIKE
  AUTHORIZATION_DENIED_SPIKE
  RATE_LIMIT_VIOLATION
  ABNORMAL_REQUEST_VOLUME
  INVALID_RESOURCE_ACCESS
  SUBMISSION_ANOMALY
  AUTHENTICATION_ANOMALY
  REFRESH_TOKEN_REUSE
  OTHER
}

enum SecuritySignalStatus {
  OPEN
  REVIEWED
  DISMISSED
}

// Elevated pattern/evidence only. Never one row per HTTP request or raw
// rate-limit hit; threshold/correlation logic belongs outside Prisma.
model SecuritySignal {
  id String @id @default(cuid())

  type     SecuritySignalType
  severity Severity
  status   SecuritySignalStatus @default(OPEN)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  source    String  @db.VarChar(60)
  ipAddress String? @db.VarChar(45)

  context Json?

  relatedAuditLogId String?
  relatedAuditLog   AuditLog? @relation(fields: [relatedAuditLogId], references: [id], onDelete: SetNull)

  alertId String?
  alert   SecurityAlert? @relation(fields: [alertId], references: [id], onDelete: SetNull)

  investigationNotes String? @db.Text

  occurredAt DateTime  @default(now())
  reviewedAt DateTime?

  @@index([userId, occurredAt(sort: Desc)])
  @@index([status, severity, occurredAt(sort: Desc)])
  @@index([ipAddress, occurredAt(sort: Desc)])
  @@index([alertId])
  @@index([relatedAuditLogId])
  @@map("security_signals")
}

enum SecurityAlertStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

model SecurityAlert {
  id String @id @default(cuid())

  title       String  @db.VarChar(200)
  description String? @db.Text

  severity Severity
  status   SecurityAlertStatus @default(OPEN)

  // Player concerned by the alert, if applicable. This is an investigative
  // subject, not a definitive accusation.
  userId String?
  user   User?   @relation("SecurityAlertSubject", fields: [userId], references: [id], onDelete: SetNull)

  reason   String? @db.Text
  metadata Json?

  triggeredAt DateTime @default(now())

  acknowledgedAt   DateTime?
  acknowledgedById String?
  acknowledgedBy   User?     @relation("SecurityAlertAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  resolvedAt      DateTime?
  resolvedById    String?
  resolvedBy      User?     @relation("SecurityAlertResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNotes String?   @db.Text

  incidentId String?
  incident   Incident? @relation(fields: [incidentId], references: [id], onDelete: SetNull)

  signals SecuritySignal[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity, triggeredAt(sort: Desc)])
  @@index([userId, triggeredAt(sort: Desc)])
  @@index([incidentId])
  @@map("security_alerts")
}

enum IncidentCategory {
  SECURITY
  AVAILABILITY
  PERFORMANCE
  DATA_INTEGRITY
  GAMEPLAY
  OPERATIONAL
  OTHER
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  MITIGATING
  RESOLVED
  CLOSED
}

model Incident {
  id String @id @default(cuid())

  title       String @db.VarChar(200)
  description String @db.Text

  category IncidentCategory
  severity Severity
  status   IncidentStatus   @default(OPEN)

  detectedAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?

  createdById String
  createdBy   User   @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  acknowledgedById String?
  acknowledgedBy   User?   @relation("IncidentAcknowledgedBy", fields: [acknowledgedById], references: [id], onDelete: SetNull)

  assignedToId String?
  assignedTo   User?   @relation("IncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)

  resolvedById String?
  resolvedBy   User?   @relation("IncidentResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  relatedUserId String?
  relatedUser   User?   @relation("IncidentRelatedUser", fields: [relatedUserId], references: [id], onDelete: SetNull)

  impact     String? @db.Text
  resolution String? @db.Text
  metadata   Json?

  securityAlerts SecurityAlert[]
  timeline       IncidentTimelineEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, severity, detectedAt(sort: Desc)])
  @@index([assignedToId, status])
  @@index([createdById])
  @@index([relatedUserId, detectedAt(sort: Desc)])
  @@map("incidents")
}

enum IncidentTimelineEntryType {
  STATUS_CHANGED
  NOTE_ADDED
  ACTION_TAKEN
  ASSIGNMENT_CHANGED
}

model IncidentTimelineEntry {
  id String @id @default(cuid())

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  type    IncidentTimelineEntryType
  content String                    @db.Text

  authorId String?
  author   User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)

  metadata   Json?
  occurredAt DateTime @default(now())

  @@index([incidentId, occurredAt])
  @@map("incident_timeline_entries")
}
